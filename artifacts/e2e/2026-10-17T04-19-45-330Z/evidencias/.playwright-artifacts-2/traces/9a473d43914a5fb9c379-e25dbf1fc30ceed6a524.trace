{"type":"frame-snapshot","snapshot":{"callId":"call@73","snapshotName":"after@call@73","pageId":"page@d4a9c7db653c7fed4d5c4fafe5a2002d","frameId":"frame@77d3cbb9126cf4a165ac691389b13974","frameUrl":"http://127.0.0.1:8011/chatbot","doctype":"html","html":["HTML",{"lang":"es"},["HEAD",{},["BASE",{"href":"http://127.0.0.1:8011/chatbot"}],"\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1"}],"\n    ",["TITLE",{},"Chatbot IA · Lunnys Perú"],"\n    ",["LINK",{"rel":"stylesheet","href":"http://127.0.0.1:8011/css/app.css?v=4"}],"\n    ",["LINK",{"rel":"stylesheet","href":"http://127.0.0.1:8011/css/management.css?v=15"}],"\n    ",["LINK",{"rel":"stylesheet","href":"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"}],"\n    ","\n    ",["STYLE",{},"\n/* Chatbot IA Styles v1.1 */\n.chatbot-container {\n    display: flex;\n    flex-direction: column;\n    height: calc(100vh - 120px);\n    max-width: 1200px;\n    margin: 0 auto;\n    background: white;\n    border-radius: 12px;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n}\n\n.chatbot-header {\n    padding: 20px 24px;\n    border-bottom: 1px solid #e5e7eb;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n}\n\n.chatbot-header h1 {\n    margin: 0;\n    font-size: 1.5rem;\n    font-weight: 600;\n    color: #111827;\n}\n\n.chatbot-messages {\n    flex: 1;\n    overflow-y: auto;\n    padding: 24px;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n}\n\n.chatbot-message {\n    display: flex;\n    gap: 12px;\n    max-width: 80%;\n    animation: fadeIn 0.3s ease-in;\n}\n\n@keyframes fadeIn {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: translateY(0); }\n}\n\n.chatbot-message.user {\n    align-self: flex-end;\n    flex-direction: row-reverse;\n}\n\n.chatbot-message.assistant {\n    align-self: flex-start;\n}\n\n.message-avatar {\n    width: 36px;\n    height: 36px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 600;\n    font-size: 14px;\n    flex-shrink: 0;\n}\n\n.message-avatar.user {\n    background: #3b82f6;\n    color: white;\n}\n\n.message-avatar.assistant {\n    background: #10b981;\n    color: white;\n    font-size: 18px;\n}\n\n.message-avatar i {\n    line-height: 1;\n}\n\n.message-content {\n    background: #f3f4f6;\n    padding: 12px 16px;\n    border-radius: 12px;\n    word-wrap: break-word;\n    white-space: pre-wrap;\n}\n\n.chatbot-message.user .message-content {\n    background: #3b82f6;\n    color: white;\n}\n\n.message-source {\n    font-size: 0.75rem;\n    color: #6b7280;\n    margin-top: 4px;\n    font-style: italic;\n}\n\n.chatbot-input-area {\n    padding: 20px 24px;\n    border-top: 1px solid #e5e7eb;\n    background: #f9fafb;\n}\n\n.chatbot-suggestions {\n    display: flex;\n    gap: 8px;\n    flex-wrap: wrap;\n    margin-bottom: 16px;\n}\n\n.suggestion-chip {\n    padding: 8px 12px;\n    background: white;\n    border: 1px solid #e5e7eb;\n    border-radius: 20px;\n    font-size: 0.875rem;\n    cursor: pointer;\n    transition: all 0.2s;\n}\n\n.suggestion-chip:hover {\n    background: #f3f4f6;\n    border-color: #3b82f6;\n}\n\n.chatbot-input-form {\n    display: flex;\n    gap: 12px;\n}\n\n.chatbot-input {\n    flex: 1;\n    padding: 12px 16px;\n    border: 1px solid #d1d5db;\n    border-radius: 8px;\n    font-size: 0.9375rem;\n    resize: none;\n    max-height: 120px;\n    font-family: inherit;\n}\n\n.chatbot-input:focus {\n    outline: none;\n    border-color: #3b82f6;\n    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);\n}\n\n.btn-send {\n    padding: 12px 24px;\n    background: #3b82f6;\n    color: white;\n    border: none;\n    border-radius: 8px;\n    font-weight: 500;\n    cursor: pointer;\n    transition: background 0.2s;\n}\n\n.btn-send:hover {\n    background: #2563eb;\n}\n\n.btn-send:disabled {\n    background: #9ca3af;\n    cursor: not-allowed;\n}\n\n.btn-new {\n    padding: 8px 16px;\n    background: white;\n    color: #374151;\n    border: 1px solid #d1d5db;\n    border-radius: 8px;\n    font-size: 0.875rem;\n    cursor: pointer;\n    transition: all 0.2s;\n}\n\n.btn-new:hover {\n    background: #f3f4f6;\n}\n\n.loading-indicator {\n    display: flex;\n    gap: 4px;\n    padding: 12px 16px;\n}\n\n.loading-dot {\n    width: 8px;\n    height: 8px;\n    background: #9ca3af;\n    border-radius: 50%;\n    animation: bounce 1.4s infinite ease-in-out;\n}\n\n.loading-dot:nth-child(1) { animation-delay: -0.32s; }\n.loading-dot:nth-child(2) { animation-delay: -0.16s; }\n\n@keyframes bounce {\n    0%, 80%, 100% { transform: scale(0); }\n    40% { transform: scale(1); }\n}\n\n.empty-state {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 48px 24px;\n    text-align: center;\n    color: #6b7280;\n}\n\n.empty-state-icon {\n    font-size: 48px;\n    margin-bottom: 16px;\n}\n\n.empty-state h2 {\n    font-size: 1.25rem;\n    font-weight: 600;\n    color: #374151;\n    margin-bottom: 8px;\n}\n\n.empty-state p {\n    font-size: 0.9375rem;\n    max-width: 500px;\n}\n\n.alert-info {\n    background: #dbeafe;\n    border: 1px solid #93c5fd;\n    color: #1e40af;\n    padding: 12px 16px;\n    border-radius: 8px;\n    margin-bottom: 16px;\n    font-size: 0.875rem;\n}\n"],"\n    ",["LINK",{"rel":"stylesheet","href":"http://127.0.0.1:8011/css/record-tables.css?v=1"}],"\n    ","\n    ","\n"],"\n",["BODY",{"class":"workspace-shell"},"\n",["A",{"class":"skip-content","href":"#module-content"},"Ir al contenido"],"\n",["HEADER",{"class":"workspace-topbar"},"\n    ",["A",{"class":"workspace-brand","href":"http://127.0.0.1:8011/dashboard"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:8011/images/lunnys-peru.png","class":"brand-logo","src":"http://127.0.0.1:8011/images/lunnys-peru.png","alt":"Logo de 