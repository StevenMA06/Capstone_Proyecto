# Copia estas variables a tu .env existente. No reemplaces todo el archivo.
# La clave API es distinta de la clave SMTP. Nunca publiques su valor.
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS=remitente-verificado@example.com
MAIL_FROM_NAME="Lunnys Perú"
# Activa solo después de comprobar la llegada del correo de prueba.
ACCESS_TWO_FACTOR_ENABLED=false
ACCESS_CODE_MINUTES=5
