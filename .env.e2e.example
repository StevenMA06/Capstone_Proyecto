# Solo pruebas: nunca uses aquí la base operativa.
E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=3306
E2E_DB_DATABASE=lunnys_e2e_test
E2E_DB_USERNAME=root
E2E_DB_PASSWORD=
# Si php no está en PATH, descomenta y ajusta:
# E2E_PHP_BIN=C:/xampp/php/php.exe
E2E_PORT=8011
# chromium usa el navegador de Playwright; chrome usa Chrome instalado.
E2E_BROWSER_CHANNEL=chromium
# simulado: datos ficticios repetibles. real: consulta API Perú y requiere DNI.
E2E_DNI_MODE=simulado
E2E_DNI=
E2E_APIPERU_API_KEY=
E2E_SCENARIO=referencia
# Python para el validador real de firmas y los PDF ficticios (sin API externa).
# E2E_SIGNATURE_PYTHON=C:/ruta/a/python.exe
# Por defecto no hay conexiones a Drive. Real sube archivos ficticios: usa una carpeta QA.
E2E_DRIVE_MODE=deshabilitado
E2E_INSTALLATION_DRIVE_FOLDER_ID=
E2E_INSTALLATION_DRIVE_CLIENT_ID=
E2E_INSTALLATION_DRIVE_CLIENT_SECRET=
E2E_INSTALLATION_DRIVE_REFRESH_TOKEN=
# Alternativa a OAuth: cuenta de servicio con acceso a la carpeta QA.
E2E_INSTALLATION_DRIVE_CREDENTIALS_PATH=
# El modo real envía consultas y datos ficticios de la base E2E a Gemini.
E2E_AI_MODE=deshabilitado
E2E_GEMINI_API_KEY=
E2E_GEMINI_MODEL=
