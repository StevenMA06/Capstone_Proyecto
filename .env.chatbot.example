# ============================================
# CONFIGURACIÓN CHATBOT IA - LUNNYS PERÚ
# ============================================

# API Key de OpenAI (ChatGPT)
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Modelo a usar (gpt-3.5-turbo es más económico)
# Opciones: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview
CHATBOT_MODEL=gpt-3.5-turbo

# Temperatura (0-2): Qué tan creativa es la respuesta
# 0.3 = Más predecible y consistente (recomendado)
# 1.0 = Balance
# 2.0 = Más creativa pero menos predecible
CHATBOT_TEMPERATURE=0.3

# Máximo de tokens en la respuesta
# 300 tokens ≈ 225 palabras (suficiente para respuestas completas)
CHATBOT_MAX_TOKENS=300

# Timeout en segundos para la llamada a la API
CHATBOT_API_TIMEOUT=30

# Habilitar logging de consultas
CHATBOT_LOGGING_ENABLED=true

# Canal de log para chatbot (debe existir en config/logging.php)
CHATBOT_LOG_CHANNEL=chatbot

# ============================================
# COSTOS ESTIMADOS (GPT-3.5-TURBO)
# ============================================
# Input:  $0.0015 por 1K tokens
# Output: $0.002 por 1K tokens
# Consulta promedio: ~$0.0005 USD
# 1000 consultas: ~$0.50 USD
# ============================================
